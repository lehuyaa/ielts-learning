APP_ENV=development
APP_PORT=8081
FRONTEND_URL=http://localhost:5175

DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=password
DB_NAME=ielts_vocab

JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL_MINUTES=1440

# Required for the AI Conversation chat endpoint (POST /ai-conversations/chat).
# Get a key at https://platform.openai.com/api-keys — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible endpoint (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# AI grading of TRANSFORM / TRANSLATE_VI_EN answers that do not match the key, per user per day.
AI_SHORT_ANSWER_DAILY_LIMIT=300
# AI writing gradings (and rewrite checks) per user per day.
AI_WRITING_DAILY_LIMIT=30
# Speech-to-text model for the admin audio import (Whisper).
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Uploaded files (imported recordings) are stored here and served at /media.
MEDIA_DIR=storage/media
